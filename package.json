{
  "name": "claude-tab-status",
  "displayName": "Claude Tab Status",
  "description": "Shows each Claude Code session's name and status (working / waiting / idle) in its VS Code terminal tab, and lists tmux-hosted sessions in a sidebar.",
  "version": "0.7.0",
  "publisher": "gongx030",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gongx030/claude-tab-status.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessions",
          "title": "Claude Sessions",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "id": "claudeTabStatus.sessions",
          "name": "tmux Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeTabStatus.sessions",
        "contents": "No Claude Code session is running in a tmux session.\n[New Session…](command:claudeTabStatus.newSession)"
      }
    ],
    "commands": [
      {
        "command": "claudeTabStatus.newSession",
        "title": "New Session…",
        "category": "Claude Sessions",
        "icon": "$(add)"
      },
      {
        "command": "claudeTabStatus.openSession",
        "title": "Open in Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeTabStatus.closeDuplicateTabs",
        "title": "Close Duplicate Tabs",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeTabStatus.refreshSessions",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeTabStatus.stopSession",
        "title": "Stop Session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "claudeTabStatus.clearSession",
        "title": "Clear Context",
        "icon": "$(clear-all)",
        "enablement": "viewItem =~ /^claudeSession\\.idle(\\.|$)/"
      },
      {
        "command": "claudeTabStatus.resumeSession",
        "title": "Resume",
        "icon": "$(play)"
      },
      {
        "command": "claudeTabStatus.resumeSessionWith",
        "title": "Resume with Backend…"
      },
      {
        "command": "claudeTabStatus.changeFolder",
        "title": "Change Folder…"
      },
      {
        "command": "claudeTabStatus.forgetSession",
        "title": "Forget"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeTabStatus.newSession",
          "when": "view == claudeTabStatus.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeTabStatus.refreshSessions",
          "when": "view == claudeTabStatus.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeTabStatus.openSession",
          "when": "view == claudeTabStatus.sessions && viewItem =~ /^claudeSession/",
          "group": "inline"
        },
        {
          "command": "claudeTabStatus.closeDuplicateTabs",
          "when": "view == claudeTabStatus.sessions && viewItem =~ /^claudeSession\\..*\\.duplicate$/",
          "group": "inline"
        },
        {
          "command": "claudeTabStatus.openSession",
          "when": "view == claudeTabStatus.sessions && viewItem =~ /^claudeSession/",
          "group": "1_session@1"
        },
        {
          "command": "claudeTabStatus.closeDuplicateTabs",
          "when": "view == claudeTabStatus.sessions && viewItem =~ /^claudeSession\\..*\\.duplicate$/",
          "group": "1_session@2"
        },
        {
          "command": "claudeTabStatus.clearSession",
          "when": "view == claudeTabStatus.sessions && viewItem =~ /^claudeSession/",
          "group": "2_lifecycle@1"
        },
        {
          "command": "claudeTabStatus.stopSession",
          "when": "view == claudeTabStatus.sessions && viewItem =~ /^claudeSession/",
          "group": "2_lifecycle@2"
        },
        {
          "command": "claudeTabStatus.resumeSession",
          "when": "view == claudeTabStatus.sessions && viewItem == claudeStopped",
          "group": "inline"
        },
        {
          "command": "claudeTabStatus.resumeSession",
          "when": "view == claudeTabStatus.sessions && viewItem == claudeStopped",
          "group": "1_session@1"
        },
        {
          "command": "claudeTabStatus.resumeSessionWith",
          "when": "view == claudeTabStatus.sessions && viewItem == claudeStopped",
          "group": "1_session@2"
        },
        {
          "command": "claudeTabStatus.changeFolder",
          "when": "view == claudeTabStatus.sessions && viewItem == claudeStopped",
          "group": "1_session@3"
        },
        {
          "command": "claudeTabStatus.forgetSession",
          "when": "view == claudeTabStatus.sessions && viewItem == claudeStopped",
          "group": "2_lifecycle@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeTabStatus.clearSession",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.stopSession",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.resumeSession",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.resumeSessionWith",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.changeFolder",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.forgetSession",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.openSession",
          "when": "false"
        },
        {
          "command": "claudeTabStatus.closeDuplicateTabs",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Tab Status",
      "properties": {
        "claudeTabStatus.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Write the Claude Code session name and status into the terminal tab title."
        },
        "claudeTabStatus.refreshIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "Interval of the process-table reconciliation, in milliseconds."
        },
        "claudeTabStatus.launcherPath": {
          "type": "string",
          "default": "",
          "description": "Path of unified-agent-sdk's unified-agent-launch, which New Session and Resume run. Empty: the first on PATH, else the py311c environment's."
        }
      }
    }
  },
  "scripts": {
    "compile": "rm -rf out && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
